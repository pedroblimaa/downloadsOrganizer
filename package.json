{
  "name": "downloads-organizer",
  "productName": "Downloads Organizer",
  "version": "0.1.0",
  "description": "Organize downloads folder",
  "main": "main.js",
  "author": "Pedro Bonfilio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^19.0.9",
    "electron-builder": "^23.6.0",
    "fs-extra": "^11.2.0",
    "nodemon": "^2.0.19"
  },
  "scripts": {
    "start": "electron .",
    "watch": "nodemon --exec electron .",
    "build:python": "node tools/build-python-exe.js",
    "build": "pnpm build:python && electron-builder"
  },
  "build": {
    "appId": "com.downloads-organizer",
    "productName": "Downloads Organizer",
    "directories": {
      "output": "dist/installers"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "afterPack": "./copy-python-script.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
